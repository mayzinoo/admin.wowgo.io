	<script src="http://code.jquery.com/jquery-latest.min.js" type="text/javascript"></script>
<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
	<script>
		function confirmwithdrawal(id,userid,wow,bal){
		var r= confirm("Are You Sure ?");
	if(r==true){
		$.ajax({
			type: "POST",
			url: '<?=base_url()?>'+"Admin/withdrawalrequest_confirm",
			data: {id:id,userid:userid,wow:wow,bal:bal},
			success: function(e)
			{
			//	$("#txtchg"+id).prop("onclick",null).off("click").html("Success");
			//	$("#txtchg"+id).css({"color":"#57da3e","font-weight":"bold"});
				$("#txtchg"+id).css({"display":"none"});
				$("#txtcancel"+id).css({"display":"none"});
				
				location.reload(); 
			}
		});
	}
	else{
	
		}
		
		}
		function cancelwithdrawal(id,userid,wow,bal){
		var r=confirm("Are You Sure to cancel ?");
		if(r==true){
			$.ajax({
				type:"POST",
				url:'<?=base_url()?>'+"Admin/withdrawalrequest_cancel",
				data:{id:id,userid:userid,wow:wow,bal:bal},
				success:function(e)
					{
					
				//	$("#txtcancel"+id).prop("onclick",null).off("click").html("Cancelled");
				//	$("#txtcancel"+id).css({"color":"#f90606","font-weight":"bold","padding":"0px","border-radius":"0px","background-color":"none","border-color":"none"});
					$("#txtcancel"+id).css({"display":"none"});
					$("#txtchg"+id).css({"display":"none"});
					location.reload(); 
					}
				});
			}
		else{ }
		}
		function withdrawalinfo(id)
		{
			data="id"+id;
			$.ajax({
				type:"POST",
				url:'<?=base_url()?>'+"Admin/withdrawalinfo",
				data:{id:id},
				success:function(e)
				{
					var v=JSON.parse(e);
					var country=v.id;
					 $('#test').modal('show');
					$('#country').val(v.country);
					$('#bankname').val(v.bank_name);
					$('#ownername').val(v.owner_name);
					$('#acctaddress').val(v.account_address);
					$('#ethaddress').val(v.ethereum_withdrawal_address);
				}
			});
		}
		function ethaddress(id)
		{
			data="id"+id;
			$.ajax({
				type:"POST",
				url:'<?=base_url()?>'+"Admin/withdrawalinfo",
				data:{id:id},
				success:function(e)
				{
					var v=JSON.parse(e);
					var country=v.id;
					$('#test').modal('show');
	
				}
		}

    
	

		
	</script>
	
